# ─── Production Environment Configuration for OneVishwam Backend ────────────
# Set these in your Firebase environment or production .env file (.env.onevishwam-backend)

# ─── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
FIREBASE_REGION=asia-south1

# ─── MongoDB Atlas (Production) ──────────────────────────────────────────
# Replace with your actual MongoDB Atlas cluster connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/onevishwam?retryWrites=true&w=majority
MONGO_MAX_POOL_SIZE=10

# ─── CORS (Add your frontend production URLs) ────────────────────────────
CORS_ORIGIN=https://onevishwam.com,https://admin.onevishwam.com,http://localhost:5173

# ─── JWT Secrets ──────────────────────────────────────────────────────────
JWT_SECRET=your_production_jwt_secret_key_here_min_32_characters
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_key_here_min_32_characters
JWT_REFRESH_EXPIRE=7d

# ─── OTP & SMS ───────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
SMS_PROVIDER=local
SMS_DEV_LOG=false

# ─── Email (Brevo SMTP) ──────────────────────────────────────────────────
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_user
BREVO_SMTP_PASS=your_brevo_password

# ─── Cloudinary (Required for serverless media storage) ──────────────────
CLOUDINARY_CLOUD_NAME=du1b92rgm
CLOUDINARY_API_KEY=688647115993563
CLOUDINARY_API_SECRET=SyDpQ21BB7e3oqpFf2-ixm3FQbM
MAX_FILE_SIZE=5242880
MAX_VIDEO_SIZE=10485760

# ─── Admin Bootstrap (Created on initial startup if not present) ─────────
ADMIN_BOOTSTRAP_EMAIL=admin@onevishwam.com
ADMIN_BOOTSTRAP_PASSWORD=YourSecureProductionPasswordHere
ADMIN_BOOTSTRAP_NAME=Super Admin
