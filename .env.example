# ─── Environment configuration for OneVishwam Backend ─────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# All secrets must be provided via environment configuration.

# ─── Core ─────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/onevishwam
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ─── JWT / Auth ───────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_to_a_long_random_string
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_SECRET=CHANGE_ME_to_a_long_random_refresh_string
JWT_REFRESH_EXPIRE=7d

# ─── OTP (registration phone OTP) ─────────────────────────────────────────
# OTP is NEVER returned by the API. In dev the OTP is only console-logged.
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ─── SMS (dev-safe; set a real provider + creds to go live) ──────────────
# local  -> dev mode: OTP is logged to console only (SMS_DEV_LOG toggles reveal)
# twilio | msg91 | fast2sms -> production providers (not configured yet)
SMS_PROVIDER=local
SMS_DEV_LOG=true

# ─── Email (for existing email-based OTP / notifications) ───────────────
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=

# ─── Cloudinary (optional - uploads degrade to local disk if absent) ─────
CLOUDINARY_CLOUD_NAME=du1b92rgm
CLOUDINARY_API_KEY=688647115993563
CLOUDINARY_API_SECRET=SyDpQ21BB7e3oqpFf2-ixm3FQbM
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads

# ─── Admin (bootstrap super-admin on first startup) ──────────────────────
ADMIN_BOOTSTRAP_EMAIL=admin@onevishwam.com
ADMIN_BOOTSTRAP_PASSWORD=Admin@789
ADMIN_BOOTSTRAP_NAME=Super Admin
