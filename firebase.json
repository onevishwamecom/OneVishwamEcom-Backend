{
  "functions": [
    {
      "source": ".",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        ".github/**",
        ".github-backup/**",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "uploads/**",
        ".env",
        ".env.*",
        ".env.local",
        "*.log",
        "mongo-backup/**",
        "tests/**",
        "__tests__/**",
        "scripts/**",
        "*.dev.js",
        "**/dist/**",
        "dist/**",
        "*.md",
        ".vscode/**",
        ".DS_Store"
      ]
    }
  ],
  "emulators": {
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}
