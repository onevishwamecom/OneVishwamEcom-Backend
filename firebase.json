{
  "functions": [
    {
      "source": ".",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        ".github/**",
        ".github-backup/**",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "uploads/**",
        "docs/**",
        ".env",
        ".env.*",
        ".env.local",
        "*.log",
        "mongo-backup/**",
        "tests/**",
        "__tests__/**",
        "scripts/**",
        "*.dev.js",
        "**/dist/**",
        "dist/**",
        "*.md",
        ".vscode/**",
        ".DS_Store",
        ".npmrc"
      ]
    }
  ],
  "emulators": {
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  },
  "hosting": {
    "site": "onevishwam-docs",
    "public": "docs",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/openapi.json",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
